"""Generador de datos en tiempo real -> Kafka. Autora: Leidi Bonilla"""
import json, random, time
from datetime import datetime
from kafka import KafkaProducer

AUTOR = "Leidi Bonilla"
TOPIC = "casos_covid"
DEPS = ["BOGOTA", "ANTIOQUIA", "VALLE DEL CAUCA", "CUNDINAMARCA", "ATLANTICO",
        "SANTANDER", "BOLIVAR", "NARIÑO", "TOLIMA", "CALDAS"]
producer = KafkaProducer(bootstrap_servers="localhost:9092",
                         value_serializer=lambda v: json.dumps(v).encode("utf-8"))
print(f"Productor iniciado - Autora: {AUTOR} - topic: {TOPIC}")
i = 0
while True:
    evento = {"id_caso": i, "departamento": random.choices(DEPS, weights=[30,20,12,8,7,6,5,4,4,4])[0],
              "sexo": random.choice(["F", "M"]), "edad": random.randint(0, 95),
              "estado": random.choices(["Leve", "Moderado", "Grave", "Fallecido"], weights=[70,18,8,4])[0],
              "fecha_evento": datetime.now().isoformat()}
    producer.send(TOPIC, evento)
    print("Enviado:", evento)
    i += 1
    time.sleep(0.5)

