# -*- coding: utf-8 -*-
"""
Tarea 3 - Big Data (UNAD 202016911)
Procesamiento en batch con Apache Spark (PySpark)
Autora: Leidi Bonilla
Dataset: Casos positivos de COVID-19 en Colombia (datos.gov.co, id gt2j-8ykr)
"""
import os, re, unicodedata, urllib.request
from pyspark.sql import SparkSession, functions as F
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

AUTOR = "Leidi Bonilla"
URL = "https://www.datos.gov.co/api/views/gt2j-8ykr/rows.csv?accessType=DOWNLOAD"
RUTA = "data/covid_colombia.csv"
os.makedirs("data", exist_ok=True)
os.makedirs("resultados", exist_ok=True)

print("=" * 60)
print(f" TAREA 3 - PROCESAMIENTO BATCH CON SPARK  |  Autora: {AUTOR}")
print("=" * 60)

# 1. CARGA desde la fuente original
if not os.path.exists(RUTA):
    print("Descargando dataset desde datos.gov.co ...")
    urllib.request.urlretrieve(URL, RUTA)

spark = (SparkSession.builder.appName(f"Batch_COVID_{AUTOR}")
         .config("spark.sql.shuffle.partitions", "8").getOrCreate())
spark.sparkContext.setLogLevel("WARN")
df = spark.read.csv(RUTA, header=True, inferSchema=False)

# Normalizar nombres de columnas (sin tildes, minúsculas, guion bajo)
def norm(s):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "_", s.lower()).strip("_")
df = df.toDF(*[norm(c) for c in df.columns])
print("Columnas:", df.columns)
df.printSchema()

def buscar(*claves):
    return next((c for c in df.columns if all(k in c for k in claves)), None)

c_dep = buscar("nombre", "departamento")
c_sexo = buscar("sexo")
c_edad = buscar("edad")
c_estado = buscar("estado")
c_fecha = buscar("fecha", "notificacion") or buscar("fecha", "reporte")
print("Columnas usadas ->", c_dep, c_sexo, c_edad, c_estado, c_fecha)

total_inicial = df.count()
print("Registros iniciales:", total_inicial)

# 2. LIMPIEZA Y TRANSFORMACIÓN
df = df.dropDuplicates()
df = (df.withColumn("departamento", F.upper(F.trim(F.col(c_dep))))
        .withColumn("sexo", F.upper(F.trim(F.col(c_sexo))))
        .withColumn("edad", F.col(c_edad).cast("int"))
        .withColumn("estado", F.initcap(F.trim(F.col(c_estado))))
        .withColumn("fecha", F.coalesce(
            F.to_date(F.substring(F.col(c_fecha), 1, 10), "yyyy-MM-dd"),
            F.to_date(F.substring(F.col(c_fecha), 1, 10), "dd/MM/yyyy"))))
df = df.filter(F.col("edad").between(0, 120)).dropna(subset=["departamento", "sexo", "edad"])
df = df.withColumn("grupo_edad", F.when(F.col("edad") < 18, "0-17")
                   .when(F.col("edad") < 30, "18-29").when(F.col("edad") < 45, "30-44")
                   .when(F.col("edad") < 60, "45-59").otherwise("60+"))
df = df.withColumn("anio_mes", F.date_format("fecha", "yyyy-MM")).cache()
print("Registros tras limpieza:", df.count())

# 3. EDA con DataFrames
print("\n--- Nulos por columna ---")
df.select([F.sum(F.col(c).isNull().cast("int")).alias(c)
           for c in ["departamento", "sexo", "edad", "estado", "fecha"]]).show()
print("--- Estadísticos de edad ---")
df.select("edad").describe().show()

por_dep = df.groupBy("departamento").count().orderBy(F.desc("count")).limit(10).toPandas()
por_sexo = df.groupBy("sexo").count().toPandas()
por_edad = df.groupBy("grupo_edad").count().orderBy("grupo_edad").toPandas()
por_mes = df.groupBy("anio_mes").count().orderBy("anio_mes").dropna().toPandas()
por_estado = df.groupBy("estado").count().orderBy(F.desc("count")).toPandas()
for nombre, t in [("Departamento", por_dep), ("Sexo", por_sexo), ("Grupo edad", por_edad), ("Estado", por_estado)]:
    print(f"--- Casos por {nombre} ---"); print(t.to_string(index=False))

# 4. Demostración con RDDs (flatMap, map, reduceByKey, take, collect)
rdd = df.select("departamento", "sexo").rdd.map(lambda r: ((r[0], r[1]), 1))
top_rdd = rdd.reduceByKey(lambda a, b: a + b).sortBy(lambda x: -x[1])
print("--- RDD: top 5 (departamento, sexo) ---", top_rdd.take(5))

# 5. VISUALIZACIÓN
def grafico(x, y, titulo, archivo, horizontal=False, kind="bar"):
    plt.figure(figsize=(10, 5))
    if kind == "line":
        plt.plot(x, y, marker="o")
        plt.xticks(rotation=90, fontsize=6)
    elif horizontal:
        plt.barh(x, y); plt.gca().invert_yaxis()
    else:
        plt.bar(x, y)
    plt.title(f"{titulo}\nElaborado por: {AUTOR}")
    plt.tight_layout(); plt.savefig(f"resultados/{archivo}", dpi=120); plt.close()

grafico(por_dep["departamento"], por_dep["count"], "Top 10 departamentos con más casos", "01_departamentos.png", True)
grafico(por_sexo["sexo"], por_sexo["count"], "Casos por sexo", "02_sexo.png")
grafico(por_edad["grupo_edad"], por_edad["count"], "Casos por grupo de edad", "03_edad.png")
grafico(por_mes["anio_mes"], por_mes["count"], "Casos por mes", "04_mes.png", kind="line")
print(f"\nGráficos guardados en ./resultados  |  Autora: {AUTOR}")
spark.stop()
