# -*- coding: utf-8 -*-
"""Spark Structured Streaming consumiendo Kafka. Autora: Leidi Bonilla"""
import os
from pyspark.sql import SparkSession, functions as F
from pyspark.sql.types import *
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

AUTOR = "Leidi Bonilla"
os.makedirs("resultados", exist_ok=True)
spark = (SparkSession.builder.appName(f"Streaming_{AUTOR}")
         .config("spark.jars.packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1")
         .config("spark.sql.shuffle.partitions", "4").getOrCreate())
spark.sparkContext.setLogLevel("WARN")
print(f"=== Spark Streaming + Kafka | Autora: {AUTOR} ===")

esquema = StructType([StructField("id_caso", IntegerType()), StructField("departamento", StringType()),
                      StructField("sexo", StringType()), StructField("edad", IntegerType()),
                      StructField("estado", StringType()), StructField("fecha_evento", StringType())])

crudo = (spark.readStream.format("kafka").option("kafka.bootstrap.servers", "localhost:9092")
         .option("subscribe", "casos_covid").option("startingOffsets", "latest").load())
eventos = (crudo.select(F.from_json(F.col("value").cast("string"), esquema).alias("e")).select("e.*"))

conteo = eventos.groupBy("departamento").agg(F.count("*").alias("total"), F.round(F.avg("edad"), 1).alias("edad_prom"))

def mostrar(batch_df, batch_id):
    pdf = batch_df.toPandas().sort_values("total", ascending=False)
    print(f"\n--- Micro-lote {batch_id} | {AUTOR} ---"); print(pdf.to_string(index=False))
    plt.figure(figsize=(9, 4.5)); plt.bar(pdf["departamento"], pdf["total"])
    plt.xticks(rotation=45, ha="right")
    plt.title(f"Casos en tiempo real por departamento (lote {batch_id})\nElaborado por: {AUTOR}")
    plt.tight_layout(); plt.savefig("resultados/streaming_tiempo_real.png", dpi=110); plt.close()

q = (conteo.writeStream.outputMode("complete").foreachBatch(mostrar)
     .trigger(processingTime="10 seconds").start())
q.awaitTermination()

